{
  "appearance": {
    "fontFamily": "Inter",
    "materialIconFont": "Material Design Icons"
  },
  "paths": {
    "pywalColors": "~/.cache/wal/colors.json",
    "screenshotsDir": "~/Pictures/Capturas"
  },
  "osd": {
    "volumeTimeoutMs": 2000,
    "brightnessTimeoutMs": 2000
  },
  "bar": {
    "screens": ["eDP-1"]
  },
  "notifications": {
    "popupWidth": 340,
    "maxVisible": 5,
    "timeoutMs": 7000,
    "registerServer": true,
    "spacing": 10,
    "margin": 10
  },
  "launcher": {
    "enabled": true,
    "width": 720,
    "maxResults": 8,
    "terminalCommand": ["foot"],
    "favorites": [
      "google-chrome-stable",
      "firefox",
      "nautilus",
      "gnome-terminal",
      "fuzzel",
      "foot",
      "code",
      "kitty"
    ]
  },
  "sidebar": {
    "enabled": true,
    "width": 420,
    "margin": 12,
    "maxHistory": 80
  },
  "controlcenter": {
    "enabled": true
  },
  "dashboard": {
    "enabled": true,
    "width": 860,
    "height": 860,
    "margin": 18
  }
}
